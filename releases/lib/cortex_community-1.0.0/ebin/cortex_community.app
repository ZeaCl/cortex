{application,cortex_community,
    [{modules,
         ['Elixir.CortexCommunity','Elixir.CortexCommunity.Application',
          'Elixir.CortexCommunity.Auth.AuthManager',
          'Elixir.CortexCommunity.Auth.ClaudeCliReader',
          'Elixir.CortexCommunity.Auth.QwenCredentialReader',
          'Elixir.CortexCommunity.Auth.ThalamusClient',
          'Elixir.CortexCommunity.CLI.Prompter',
          'Elixir.CortexCommunity.Clients.ClaudeOAuthClient',
          'Elixir.CortexCommunity.Clients.ClaudeWebClient',
          'Elixir.CortexCommunity.CortexApiKey',
          'Elixir.CortexCommunity.CortexUser',
          'Elixir.CortexCommunity.Credentials',
          'Elixir.CortexCommunity.ModelDiscovery.ModelInfo',
          'Elixir.CortexCommunity.ModelDiscovery.ModelRanking',
          'Elixir.CortexCommunity.ModelDiscovery.ProviderModel',
          'Elixir.CortexCommunity.ModelSelector',
          'Elixir.CortexCommunity.Release','Elixir.CortexCommunity.Repo',
          'Elixir.CortexCommunity.StatsCollector',
          'Elixir.CortexCommunity.UserCredential',
          'Elixir.CortexCommunity.Users',
          'Elixir.CortexCommunity.UsersBehaviour',
          'Elixir.CortexCommunity.Workers.AnthropicOAuthWorker',
          'Elixir.CortexCommunity.Workers.QwenOAuthWorker',
          'Elixir.CortexCommunityWeb',
          'Elixir.CortexCommunityWeb.ChatController',
          'Elixir.CortexCommunityWeb.CoreComponents',
          'Elixir.CortexCommunityWeb.DocsController',
          'Elixir.CortexCommunityWeb.Endpoint',
          'Elixir.CortexCommunityWeb.ErrorHTML',
          'Elixir.CortexCommunityWeb.ErrorJSON',
          'Elixir.CortexCommunityWeb.Gettext',
          'Elixir.CortexCommunityWeb.HealthController',
          'Elixir.CortexCommunityWeb.Layouts',
          'Elixir.CortexCommunityWeb.ModelsController',
          'Elixir.CortexCommunityWeb.PageController',
          'Elixir.CortexCommunityWeb.PageHTML',
          'Elixir.CortexCommunityWeb.Plugs.AuthenticateApiKey',
          'Elixir.CortexCommunityWeb.Plugs.RequestLogger',
          'Elixir.CortexCommunityWeb.Router',
          'Elixir.CortexCommunityWeb.SearchController',
          'Elixir.CortexCommunityWeb.StatsController',
          'Elixir.CortexCommunityWeb.Telemetry',
          'Elixir.CortexCommunityWeb.ToolsController',
          'Elixir.Mix.Tasks.Cortex.Keygen','Elixir.Mix.Tasks.Cortex.Setup']},
     {compile_env,
         [{cortex_community,['Elixir.CortexCommunityWeb.Gettext'],error},
          {cortex_community,[cortex_core],error}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,runtime_tools,cortex_core,phoenix,
          phoenix_html,phoenix_live_view,phoenix_live_dashboard,plug_cowboy,
          cors_plug,jason,httpoison,gettext,telemetry_metrics,
          telemetry_poller,dotenvy,ecto_sql,postgrex]},
     {description,"Open-source AI gateway powered by Cortex Core"},
     {registered,[]},
     {vsn,"1.0.0"},
     {mod,{'Elixir.CortexCommunity.Application',[]}}]}.
