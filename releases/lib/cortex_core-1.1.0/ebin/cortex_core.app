{application,cortex_core,
             [{modules,['Elixir.CortexCore','Elixir.CortexCore.Behaviour',
                        'Elixir.CortexCore.Dispatcher',
                        'Elixir.CortexCore.ModelDiscovery',
                        'Elixir.CortexCore.Workers.APIKeyManager',
                        'Elixir.CortexCore.Workers.Adapters.APIWorkerBase',
                        'Elixir.CortexCore.Workers.Adapters.AnthropicWorker',
                        'Elixir.CortexCore.Workers.Adapters.BraveWorker',
                        'Elixir.CortexCore.Workers.Adapters.CohereWorker',
                        'Elixir.CortexCore.Workers.Adapters.DuckDuckGoWorker',
                        'Elixir.CortexCore.Workers.Adapters.GeminiWorker',
                        'Elixir.CortexCore.Workers.Adapters.GroqWorker',
                        'Elixir.CortexCore.Workers.Adapters.MLXWorker',
                        'Elixir.CortexCore.Workers.Adapters.OllamaWorker',
                        'Elixir.CortexCore.Workers.Adapters.OpenAIEmbeddingsWorker',
                        'Elixir.CortexCore.Workers.Adapters.OpenAIWorker',
                        'Elixir.CortexCore.Workers.Adapters.PubMedWorker',
                        'Elixir.CortexCore.Workers.Adapters.SerperWorker',
                        'Elixir.CortexCore.Workers.Adapters.TavilyWorker',
                        'Elixir.CortexCore.Workers.Adapters.XAIWorker',
                        'Elixir.CortexCore.Workers.Pool',
                        'Elixir.CortexCore.Workers.Registry',
                        'Elixir.CortexCore.Workers.Supervisor',
                        'Elixir.CortexCore.Workers.Worker']},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger,crypto,req,finch,
                             jason]},
              {description,"A powerful multi-provider AI gateway library for Elixir. Provides intelligent\nfailover, API key rotation, streaming support, and unified interface for\nOpenAI, Anthropic, Google Gemini, Groq, Cohere, and local models via Ollama.\n"},
              {registered,[]},
              {vsn,"1.1.0"}]}.
