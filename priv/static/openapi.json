{
  "openapi": "3.1.0",
  "info": {
    "title": "Cortex Community API",
    "version": "1.0.0",
    "description": "Gateway de IA unificado. Enruta requests a múltiples providers (Gemini, Groq, Anthropic) con failover automático, model discovery y búsqueda web/científica."
  },
  "servers": [
    { "url": "http://localhost:4000", "description": "Local" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key de Cortex. Formato: `ctx_xxxxxxxxxxxxxxxx`. Requerida en todos los endpoints excepto /api/health* y /api/stats*."
      }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant", "tool"],
            "description": "Rol del mensaje"
          },
          "content": {
            "type": "string",
            "description": "Contenido del mensaje"
          }
        }
      },
      "ToolFunction": {
        "type": "object",
        "required": ["name", "description", "parameters"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "parameters": {
            "type": "object",
            "description": "JSON Schema de los parámetros de la función"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": ["type", "function"],
        "properties": {
          "type": { "type": "string", "enum": ["function"] },
          "function": { "$ref": "#/components/schemas/ToolFunction" }
        }
      },
      "ToolCall": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Nombre de la función a llamar" },
          "arguments": { "type": "object", "description": "Argumentos de la función" }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "content": { "type": "string" },
          "score": { "type": "number", "description": "Relevancia 0-1 (solo Tavily)" }
        }
      },
      "PubMedResult": {
        "type": "object",
        "properties": {
          "pmid": { "type": "string" },
          "title": { "type": "string" },
          "authors": { "type": "string" },
          "journal": { "type": "string" },
          "doi": { "type": "string" },
          "url": { "type": "string" },
          "publication_date": { "type": "string" }
        }
      },
      "WorkerStatus": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["available", "unavailable", "rate_limited", "unknown"] },
          "type": { "type": "string" },
          "api_keys_count": { "type": "integer" },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["chat", "tools", "long_context", "vision", "fast", "reasoning", "search"] },
            "description": "Declared capabilities for this worker. Workers with 'tools' support function calling."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "message": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/chat": {
      "post": {
        "summary": "Chat con streaming SSE",
        "description": "Envía mensajes y recibe la respuesta como stream SSE. Cortex elige el mejor worker disponible y hace failover automático. Omitir `provider` es lo recomendado.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Message" },
                    "description": "Historial de la conversación"
                  },
                  "provider": {
                    "type": "string",
                    "description": "Opcional. Worker específico a usar (ej: 'groq-primary'). Sin este campo, Cortex hace failover automático entre todos los workers disponibles.",
                    "example": "groq-primary"
                  },
                  "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
                  "max_tokens": { "type": "integer" },
                  "top_p": { "type": "number" },
                  "stop": {
                    "oneOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" } }
                    ]
                  }
                }
              },
              "example": {
                "messages": [
                  { "role": "system", "content": "Eres un asistente útil." },
                  { "role": "user", "content": "Explica qué es una red neuronal." }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream SSE. Cada chunk es una línea `data: {...}`. El stream termina con `event: done`.",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" },
                "example": "data: {\"content\": \"Una red \"}\n\ndata: {\"content\": \"neuronal es...\"}\n\nevent: done\ndata: {\"done\": true, \"model\": \"llama-3.3-70b-versatile\", \"worker\": \"groq-primary\"}\n\n"
              }
            }
          },
          "400": { "description": "Falta el campo `messages`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "API key inválida o ausente" },
          "503": { "description": "Sin workers disponibles" }
        }
      }
    },
    "/api/completions": {
      "post": {
        "summary": "Chat — alias OpenAI-compatible",
        "description": "Alias de `/api/chat`. Mismo contrato, mismo comportamiento. Útil para herramientas que apuntan a la URL de completions de OpenAI.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/paths/~1api~1chat/post/requestBody" },
        "responses": { "$ref": "#/paths/~1api~1chat/post/responses" }
      }
    },
    "/api/search": {
      "post": {
        "summary": "Búsqueda web o científica",
        "description": "Realiza búsquedas usando el provider especificado. Para web: tavily, duckduckgo, brave, serper. Para literatura científica: pubmed.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query", "provider"],
                "properties": {
                  "query": { "type": "string", "description": "Término de búsqueda" },
                  "provider": {
                    "type": "string",
                    "enum": ["tavily-primary", "duckduckgo-primary", "brave-primary", "serper-primary", "pubmed-primary"],
                    "description": "Provider de búsqueda a usar"
                  },
                  "max_results": { "type": "integer", "default": 10, "minimum": 1, "maximum": 20 },
                  "search_depth": {
                    "type": "string",
                    "enum": ["basic", "advanced"],
                    "description": "Profundidad de búsqueda (solo Tavily)"
                  },
                  "publication_type": {
                    "type": "string",
                    "description": "Tipo de publicación a filtrar (solo PubMed)"
                  }
                }
              },
              "examples": {
                "web": {
                  "summary": "Búsqueda web",
                  "value": { "provider": "tavily-primary", "query": "Phoenix LiveView 2025", "max_results": 5 }
                },
                "pubmed": {
                  "summary": "Literatura científica",
                  "value": { "provider": "pubmed-primary", "query": "cancer immunotherapy CAR-T", "max_results": 5 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultados de búsqueda",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              { "$ref": "#/components/schemas/SearchResult" },
                              { "$ref": "#/components/schemas/PubMedResult" }
                            ]
                          }
                        },
                        "answer": { "type": "string", "description": "Resumen generado por IA (solo Tavily)" },
                        "source": { "type": "string", "description": "Fuente (ej: 'PubMed')" },
                        "response_time": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Falta `query` o `provider` inválido" },
          "401": { "description": "API key inválida" },
          "503": { "description": "Provider de búsqueda no disponible" }
        }
      }
    },
    "/api/tools": {
      "post": {
        "summary": "Function calling / structured extraction",
        "description": "Ejecuta function calling. Devuelve las tool_calls sin streaming. `provider` es opcional — sin él, Cortex auto-selecciona entre workers con soporte :tools (gemini, groq, anthropic, openai). Especificar un worker sin soporte tools retorna 400.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages", "tools"],
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Message" }
                  },
                  "tools": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Tool" }
                  },
                  "provider": {
                    "type": "string",
                    "description": "Opcional. Worker específico a usar (debe tener capacidad :tools). Sin este campo, Cortex auto-selecciona con failover.",
                    "example": "gemini-primary"
                  },
                  "tool_choice": {
                    "oneOf": [
                      { "type": "string", "enum": ["auto", "none"] },
                      {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string", "enum": ["function"] },
                          "function": { "type": "object", "properties": { "name": { "type": "string" } } }
                        }
                      }
                    ],
                    "description": "Cómo elegir la tool. Default: 'auto'."
                  },
                  "model": { "type": "string", "description": "Modelo específico (opcional)" }
                }
              },
              "example": {
                "provider": "gemini-primary",
                "messages": [{ "role": "user", "content": "¿Cuál es el clima en Santiago?" }],
                "tools": [{
                  "type": "function",
                  "function": {
                    "name": "get_weather",
                    "description": "Obtiene el clima de una ciudad",
                    "parameters": {
                      "type": "object",
                      "properties": {
                        "city": { "type": "string" },
                        "units": { "type": "string", "enum": ["celsius", "fahrenheit"] }
                      },
                      "required": ["city"]
                    }
                  }
                }]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool calls a ejecutar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "tool_calls": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ToolCall" }
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "tool_calls": [{ "name": "get_weather", "arguments": { "city": "Santiago", "units": "celsius" } }]
                }
              }
            }
          },
          "400": { "description": "Falta `messages`, `tools` o `provider`" },
          "401": { "description": "API key inválida" }
        }
      }
    },
    "/api/models": {
      "get": {
        "summary": "Lista workers y modelos activos",
        "description": "Devuelve todos los workers configurados con su estado y modelo activo. Los modelos son descubiertos automáticamente al iniciar y se actualizan cada 5 minutos.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Lista de workers",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "data": {
                    "llm": [
                      { "name": "groq-primary", "status": "available", "model": "llama-3.3-70b-versatile" },
                      { "name": "gemini-primary", "status": "available", "model": "gemini-2.5-flash" },
                      { "name": "anthropic-primary", "status": "available", "model": "claude-sonnet-4-6" }
                    ],
                    "search": [
                      { "name": "tavily-primary", "status": "available" },
                      { "name": "duckduckgo-primary", "status": "available" },
                      { "name": "pubmed-primary", "status": "available" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "description": "API key inválida" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Estado básico del servidor",
        "description": "Endpoint público. Devuelve si el servidor está operativo y cuántos workers hay disponibles.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ready",
                  "timestamp": "2026-03-09T10:00:00Z",
                  "available_workers": 3,
                  "total_workers": 3
                }
              }
            }
          }
        }
      }
    },
    "/api/health/workers": {
      "get": {
        "summary": "Estado por worker",
        "description": "Endpoint público. Lista todos los workers con su estado individual.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "workers": { "type": "array", "items": { "$ref": "#/components/schemas/WorkerStatus" } },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "available": { "type": "integer" },
                        "unavailable": { "type": "integer" },
                        "rate_limited": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/detailed": {
      "get": {
        "summary": "Estado completo con modelos y recomendaciones",
        "description": "Endpoint público. Incluye modelos activos, fallback models y recomendaciones por tipo de tarea. Útil para servicios externos que quieren verificar qué está disponible antes de hacer requests.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ready",
                  "timestamp": "2026-03-09T10:00:00Z",
                  "llm": {
                    "total": 3,
                    "available": 3,
                    "workers": [
                      {
                        "name": "groq-primary",
                        "status": "available",
                        "model": "llama-3.3-70b-versatile",
                        "fallback_models": ["llama-3.1-70b-versatile", "mixtral-8x7b-32768"],
                        "last_discovery": "2026-03-09T09:55:00Z"
                      }
                    ]
                  },
                  "search": { "total": 3, "available": 2, "workers": [] },
                  "recommendations": {
                    "chat": "groq-primary",
                    "coding": "gemini-primary",
                    "reasoning": "anthropic-primary",
                    "tools": "gemini-primary",
                    "long_context": "gemini-primary",
                    "fast": "groq-primary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Métricas de uso globales",
        "description": "Endpoint público. Devuelve contadores de requests, tokens y latencia desde que arrancó el servidor.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "requests": { "total": 1420, "completed": 1380, "errors": 40 },
                  "tokens": { "total": 284000 },
                  "latency_ms": { "avg": 823, "p95": 2100 }
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/providers": {
      "get": {
        "summary": "Métricas por provider",
        "description": "Endpoint público. Desglose de uso por cada worker.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "providers": {
                    "groq-primary":     { "requests": 800, "tokens": 160000, "errors": 10 },
                    "gemini-primary":   { "requests": 500, "tokens": 100000, "errors": 20 },
                    "anthropic-primary":{ "requests": 120, "tokens": 24000,  "errors": 10 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
