# Cortex Community — ejemplo de configuración
# Copia este archivo a .env y agrega tus API keys.
# Los modelos se descubren automáticamente — no necesitas configurarlos.

# ========================================
#  LLM Providers (agrega las keys que tengas)
# ========================================
# GROQ_API_KEYS=gsk_...
# GEMINI_API_KEYS=AIzaSy...
# ANTHROPIC_API_KEYS=sk-ant-api03-...
# OPENAI_API_KEYS=sk-...
# XAI_API_KEYS=xai-...
# COHERE_API_KEYS=...
# GEMINI_PRO_25_API_KEYS=AIzaSy...  # key separada si tienes cuota adicional

# ========================================
#  Search Providers
# ========================================
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
# BRAVE_API_KEY=...

# ========================================
#  Auth — Thalamus OAuth2
# ========================================
# Auth mode: local | thalamus | hybrid (default)
AUTH_MODE=hybrid

# Thalamus OAuth2 (requerido para AUTH_MODE=thalamus|hybrid)
THALAMUS_INTROSPECT_URL=http://auth.zea.localhost/oauth/introspect
THALAMUS_CLIENT_ID=cortex-local
THALAMUS_CLIENT_SECRET=dev-secret
THALAMUS_CACHE_TTL=60

# ========================================
#  Infraestructura
# ========================================
PORT=4000
WORKER_POOL_STRATEGY=local_first   # local_first | round_robin | least_used | random
HEALTH_CHECK_INTERVAL=0            # segundos (0 = deshabilitado, 300 = 5 min en prod)
